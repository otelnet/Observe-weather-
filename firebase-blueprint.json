{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document stored under /users/{userId}",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "FavoriteLocation": {
      "title": "FavoriteLocation",
      "description": "User saved favorite location stored under /users/{userId}/favorites/{locationId}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "isHKO": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "lat", "lon"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/favorites/{locationId}": {
      "schema": { "$ref": "#/entities/FavoriteLocation" },
      "description": "User saved favorite weather stations"
    }
  }
}
